<% if (articleChain && articleChain.contract_address) { %>
  <details class="article-onchain" aria-label="On-chain publication">
    <summary class="article-onchain-status">This article is archived on the <strong>Polygon blockchain</strong> with a publicly verifiable on-chain record.</summary>
    <div class="article-onchain-details">
    <div class="article-onchain-row">
      <span class="article-onchain-label">Block Height</span>
      <span class="onchain-value-wrap">
        <span class="block-height-pair">
          <span class="onchain-text" title="Publication block"><%= articleChain.block_height %></span>
          <span class="block-height-arrow" aria-hidden="true">&rarr;</span>
          <span class="onchain-text" data-latest-block data-rpc-url="https://polygon.drpc.org" title="Latest block"><span class="block-ticker"><span data-block-number><%= articleChain.latest_block_height %></span></span></span>
          <span class="block-loader" title="Loading latest Polygon block" aria-hidden="true"></span>
          <span class="live-indicator" title="Live Polygon block height" aria-hidden="true"></span>
        </span>
      </span>
    </div>
    <div class="article-onchain-row">
      <span class="article-onchain-label">Transaction Hash</span>
      <span class="onchain-value-wrap">
        <span class="onchain-text"><%= articleChain.transaction_hash %></span>
      </span>
    </div>
    <div class="article-onchain-row">
      <span class="article-onchain-label">Contract Address</span>
      <span class="onchain-value-wrap">
        <a class="onchain-link" href="https://polygonscan.com/address/<%= articleChain.contract_address %>" target="_blank" rel="noreferrer"><%= articleChain.contract_address %></a>
      </span>
    </div>
    </div>
  </details>
<% } %>
